{
  "name": "@codemark/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist', { recursive: true })\" && wrangler dev --port 8787 --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit && tsc --noEmit -p seed",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx seed/reset.ts"
  },
  "dependencies": {
    "@codemark/contracts": "workspace:*",
    "@codemark/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
